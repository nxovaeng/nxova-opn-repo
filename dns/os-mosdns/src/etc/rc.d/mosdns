#!/bin/sh
#
# PROVIDE: mosdns
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# os-mosdns: MosDNS dynamic DNS forwarder (mosdns-pf build with pf_alias plugin).
# Enable flag is managed by the plugin template in /etc/rc.conf.d/mosdns.

. /etc/rc.subr

name=mosdns
rcvar=mosdns_enable

pidfile=/var/run/mosdns.pid
procname=/usr/local/bin/mosdns
command=/usr/sbin/daemon
# -o captures mosdns's stdio: the config template sets only
# log level (no file), and the UI log page tails
# /var/log/mosdns.log. Without it daemon discards the output
# and the log page stays empty.
command_args="-p ${pidfile} -o /var/log/mosdns.log ${procname} start -c /usr/local/etc/mosdns/config.yaml"

load_rc_config $name
run_rc_command "$1"
