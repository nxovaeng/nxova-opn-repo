<model>
    <mount>//OPNsense/mosdns</mount>
    <version>1.3.0</version>
    <description>MosDNS dynamic DNS forwarder with pf table sync</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <listen_address type="TextField">
                <default>0.0.0.0</default>
                <Required>Y</Required>
                <ValidationMessage>Please specify a listen address.</ValidationMessage>
            </listen_address>
            <listen_port type="PortField">
                <default>5353</default>
                <Required>Y</Required>
            </listen_port>
            <mode type="OptionField">
                <default>whitelist</default>
                <Required>Y</Required>
                <OptionValues>
                    <whitelist>白名单（默认走代理）</whitelist>
                    <blacklist>黑名单（默认直连）</blacklist>
                    <custom>自定义（名单分流 + 默认走向）</custom>
                </OptionValues>
            </mode>
            <custom_default_route type="OptionField">
                <default>proxy</default>
                <Required>Y</Required>
                <OptionValues>
                    <direct>直连</direct>
                    <proxy>代理</proxy>
                </OptionValues>
            </custom_default_route>
            <block_enabled type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </block_enabled>
        </general>
        <forward>
            <remote_upstreams type="TextField">
                <default>tcp://1.1.1.1:53,tcp://8.8.8.8:53,https://1.1.1.1/dns-query</default>
                <Required>Y</Required>
                <ValidationMessage>Specify at least one remote (proxy) upstream, comma separated.</ValidationMessage>
            </remote_upstreams>
            <remote_socks5 type="TextField">
                <default></default>
            </remote_socks5>
            <local_upstreams type="TextField">
                <default>223.5.5.5,119.29.29.29</default>
                <Required>Y</Required>
                <ValidationMessage>Specify at least one local (direct) upstream, comma separated.</ValidationMessage>
            </local_upstreams>
        </forward>
        <pfalias>
            <enabled type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </enabled>
            <table type="TextField">
                <default>proxy_group</default>
                <Required>Y</Required>
                <ValidationMessage>Target pf table name (OPNsense External alias).</ValidationMessage>
                <Mask>/^[A-Za-z0-9_]{1,31}$/</Mask>
            </table>
            <min_ttl type="IntegerField">
                <default>60</default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>86400</MaximumValue>
            </min_ttl>
            <max_ttl type="IntegerField">
                <default>86400</default>
                <Required>Y</Required>
                <MinimumValue>60</MinimumValue>
                <MaximumValue>86400</MaximumValue>
            </max_ttl>
            <timeout type="TextField">
                <default>100ms</default>
            </timeout>
            <sync type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </sync>
        </pfalias>
        <pfaliasd>
            <enabled type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </enabled>
            <socket_path type="TextField">
                <default>/var/run/pf-aliasd.sock</default>
                <Required>Y</Required>
                <ValidationMessage>Unix socket path shared by pf-aliasd and the mosdns pf_alias plugin.</ValidationMessage>
            </socket_path>
            <flush_tables type="TextField">
                <default></default>
            </flush_tables>
        </pfaliasd>
        <rulegroups>
            <group type="ArrayField">
                <enabled type="BooleanField">
                    <default>1</default>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                </name>
                <type type="OptionField">
                    <default>direct</default>
                    <Required>Y</Required>
                    <OptionValues>
                        <direct>直连</direct>
                        <proxy>代理</proxy>
                        <block>阻止</block>
                    </OptionValues>
                </type>
                <tags type="TextField">
                    <help>Comma separated free tags, e.g. ai,work,home.</help>
                </tags>
                <source type="OptionField">
                    <default>local</default>
                    <Required>Y</Required>
                    <OptionValues>
                        <local>本地</local>
                        <remote>在线</remote>
                    </OptionValues>
                </source>
                <url type="TextField">
                    <help>Remote rule list URL (plain txt, one rule per line).</help>
                </url>
            </group>
        </rulegroups>
    </items>
</model>
