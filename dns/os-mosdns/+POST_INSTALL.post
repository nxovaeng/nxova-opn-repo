# os-mosdns: flush OPNsense UI caches after install.
# Mirrors system_cache_flush() in src/etc/inc/system.inc, but does not depend
# on the PHP stack (which may be broken mid-install, e.g. by a model error).
#  - menu cache: merged Menu.xml, TTL 3600s (MenuSystem::persist)
#  - model caches: mdl_cache_*.json
#  - compiled volt templates
rm -f /var/lib/php/tmp/opnsense_menu_cache.xml
rm -f /var/lib/php/tmp/mdl_cache_*.json
rm -f /var/lib/php/cache/*.php
# Reset PHP OPcache so new controller actions take effect (old PHP files may be cached).
# Reset PHP OPcache so new controller actions take effect.
# OPNsense does not ship a php-fpm rc script; use its webgui restart helper.
/usr/local/etc/rc.restart_webgui 2>/dev/null || true
# Reload configd so new actions (rules.*, etc.) take effect.
service configd restart 2>/dev/null || true

# Rule files referenced by the mosdns config must exist before first start
# (they are (re)generated by rule merges; create empty stubs on install).
mkdir -p /usr/local/etc/mosdns/rule/groups
for f in custom_direct custom_proxy custom_block sync_direct sync_proxy sync_block; do
    if [ ! -e "/usr/local/etc/mosdns/rule/${f}.txt" ]; then
        echo "# generated by os-mosdns rule merge" > "/usr/local/etc/mosdns/rule/${f}.txt"
    fi
done
