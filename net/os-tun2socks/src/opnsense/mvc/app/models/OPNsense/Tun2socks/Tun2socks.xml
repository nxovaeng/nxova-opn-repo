<model>
    <mount>//OPNsense/tun2socks</mount>
    <version>1.1.0</version>
    <description>tun2socks daemon (xjasonlyu/tun2socks)</description>
    <items>
        <tunnel>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <name type="TextField">
                <default>tun_hev</default>
                <Required>Y</Required>
                <ValidationMessage>Specify the TUN interface name.</ValidationMessage>
                <Mask>/^[A-Za-z0-9_]{1,15}$/</Mask>
            </name>
            <mtu type="TextField">
                <default>1500</default>
                <Required>Y</Required>
                <ValidationMessage>Specify the TUN MTU.</ValidationMessage>
                <Mask>/^[0-9]{1,5}$/</Mask>
            </mtu>
            <ipv4 type="TextField">
                <default>198.18.0.1</default>
                <Required>Y</Required>
                <ValidationMessage>Specify the TUN virtual IPv4 address.</ValidationMessage>
            </ipv4>
            <ipv6 type="TextField">
                <default></default>
            </ipv6>
        </tunnel>
        <socks5>
            <address type="TextField">
                <default>127.0.0.1</default>
                <Required>Y</Required>
                <ValidationMessage>Specify the upstream SOCKS5 address.</ValidationMessage>
            </address>
            <port type="PortField">
                <default>10808</default>
                <Required>Y</Required>
            </port>
            <username type="TextField">
                <default></default>
            </username>
            <password type="TextField">
                <default></default>
            </password>
        </socks5>
        <misc>
            <log_level type="OptionField">
                <default>info</default>
                <Required>Y</Required>
                <OptionValues>
                    <debug>debug</debug>
                    <info>info</info>
                    <warn>warn</warn>
                    <error>error</error>
                </OptionValues>
            </log_level>
            <log_file type="TextField">
                <default>/var/log/tun2socks.log</default>
                <Required>Y</Required>
            </log_file>
        </misc>
    </items>
</model>
