# Generated by os-tun2socks - DO NOT EDIT MANUALLY
# xjasonlyu/tun2socks runs on CLI flags; this file carries them for rc.d.
{% set _m = OPNsense.tun2socks|default({}) %}
{% set tunnel = _m.tunnel|default({}) %}
{% set socks5 = _m.socks5|default({}) %}
{% set misc = _m.misc|default({}) %}
tun2socks_enable="{% if tunnel.enabled|default('0') == '1' %}YES{% else %}NO{% endif %}"
tun2socks_device="{{ tunnel.name|default('tun_hev') }}"
{# Jinja urlencode leaves '/' unencoded, which would split the proxy URL:
   force-encode it after urlencode (auth segments only). #}
{% if socks5.username|default('') != '' %}
tun2socks_proxy='socks5://{{ socks5.username|urlencode|replace('/','%2F') }}:{{ socks5.password|default('')|urlencode|replace('/','%2F') }}@{{ socks5.address|default('127.0.0.1') }}:{{ socks5.port|default('10808') }}'
{% else %}
tun2socks_proxy='socks5://{{ socks5.address|default('127.0.0.1') }}:{{ socks5.port|default('10808') }}'
{% endif %}
tun2socks_mtu="{{ tunnel.mtu|default('1500') }}"
tun2socks_loglevel="{{ misc.log_level|default('info') }}"
tun2socks_logfile="{{ misc.log_file|default('/var/log/tun2socks.log') }}"
tun2socks_ipv4="{{ tunnel.ipv4|default('198.18.0.1') }}"
tun2socks_ipv6="{{ tunnel.ipv6|default('') }}"
