<form>
    <field>
        <id>inbound.enabled</id>
        <label>启用</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>inbound.tag</id>
        <label>标签</label>
        <type>text</type>
        <help>入站标签。tun2socks-in（127.0.0.1:10808）是给 tun2socks 用的固定入站，别删。</help>
    </field>
    <field>
        <id>inbound.protocol</id>
        <label>协议</label>
        <type>dropdown</type>
        <help>socks / http。</help>
    </field>
    <field>
        <id>inbound.listen</id>
        <label>监听地址</label>
        <type>text</type>
        <help>一般 127.0.0.1（仅本机），要给局域网用填 0.0.0.0。</help>
    </field>
    <field>
        <id>inbound.port</id>
        <label>端口</label>
        <type>text</type>
    </field>
    <field>
        <id>inbound.sniffing</id>
        <label>协议嗅探</label>
        <type>checkbox</type>
        <help>嗅探 http/tls/quic 域名用于分流（仅路由，不改写）。</help>
    </field>
    <field>
        <id>inbound.username</id>
        <label>用户名</label>
        <type>text</type>
        <help>留空为无认证。</help>
    </field>
    <field>
        <id>inbound.password</id>
        <label>密码</label>
        <type>password</type>
    </field>
</form>
