<form>
    <field>
        <id>xray.rules.rule.enabled</id>
        <label>启用</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>xray.rules.rule.type</id>
        <label>类型</label>
        <type>dropdown</type>
        <help>domain 按域名匹配，ip 按 IP/CIDR 匹配。</help>
    </field>
    <field>
        <id>xray.rules.rule.values</id>
        <label>值</label>
        <type>text</type>
        <help>逗号分隔的域名或 IP，如 google.com,youtube.com。</help>
    </field>
    <field>
        <id>xray.rules.rule.outbound_tag</id>
        <label>出站</label>
        <type>text</type>
        <help>节点标签；填 direct 直连、block 拒绝；留空走默认节点。</help>
    </field>
</form>
