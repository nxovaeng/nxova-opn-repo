<form>
    <field>
        <id>xray.rules.rule.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>xray.rules.rule.type</id>
        <label>Type</label>
        <type>dropdown</type>
    </field>
    <field>
        <id>xray.rules.rule.values</id>
        <label>Values</label>
        <type>text</type>
        <help>Comma separated domains or IPs.</help>
    </field>
    <field>
        <id>xray.rules.rule.outbound_tag</id>
        <label>Outbound</label>
        <type>text</type>
        <help>Node tag, 'direct', 'block', or empty for the default node.</help>
    </field>
</form>
