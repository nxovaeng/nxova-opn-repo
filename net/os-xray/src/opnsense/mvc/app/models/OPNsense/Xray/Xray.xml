<model>
    <mount>//OPNsense/xray</mount>
    <version>1.6.0</version>
    <description>Xray-core routing engine manager (custom config, no conflict with official package)</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <active_node type="TextField">
                <Mask>/^[a-f0-9\-]*$/</Mask>
            </active_node>
            <domain_strategy type="OptionField">
                <default>IPIfNonMatch</default>
                <Required>Y</Required>
                <OptionValues>
                    <AsIs>AsIs</AsIs>
                    <IPIfNonMatch>IPIfNonMatch</IPIfNonMatch>
                    <IPOnDemand>IPOnDemand</IPOnDemand>
                </OptionValues>
            </domain_strategy>
            <log_level type="OptionField">
                <default>warning</default>
                <Required>Y</Required>
                <OptionValues>
                    <debug>debug</debug>
                    <info>info</info>
                    <warning>warning</warning>
                    <error>error</error>
                    <none>none</none>
                </OptionValues>
            </log_level>
            <dns_servers type="TextField">
                <default>tcp://1.1.1.1:53,tcp://8.8.8.8:53,https://1.1.1.1/dns-query</default>
            </dns_servers>
            <dns_query_strategy type="OptionField">
                <default>UseIP</default>
                <Required>Y</Required>
                <OptionValues>
                    <UseIP>UseIP（IPv4+IPv6）</UseIP>
                    <UseIPv4>UseIPv4（仅 IPv4）</UseIPv4>
                    <UseIPv6>UseIPv6（仅 IPv6）</UseIPv6>
                </OptionValues>
            </dns_query_strategy>
            <default_outbound type="OptionField">
                <default>proxy-default</default>
                <Required>Y</Required>
                <OptionValues>
                    <proxy-default>默认节点</proxy-default>
                    <direct>直连</direct>
                    <block>拦截</block>
                </OptionValues>
                <help>没有规则命中时的走向：默认节点（活动节点）、直连、拦截。</help>
            </default_outbound>
        </general>
        <nodes>
            <node type="ArrayField">
                <enabled type="BooleanField">
                    <default>1</default>
                </enabled>
                <tag type="TextField">
                    <Required>Y</Required>
                </tag>
                <protocol type="OptionField">
                    <Required>Y</Required>
                    <OptionValues>
                        <vless>vless</vless>
                        <vmess>vmess</vmess>
                        <trojan>trojan</trojan>
                        <shadowsocks>shadowsocks</shadowsocks>
                    </OptionValues>
                </protocol>
                <address type="TextField">
                    <Required>Y</Required>
                </address>
                <port type="PortField">
                    <Required>Y</Required>
                </port>
                <network type="OptionField">
                    <default>tcp</default>
                    <OptionValues>
                        <tcp>tcp</tcp>
                        <ws>ws</ws>
                        <xhttp>xhttp</xhttp>
                        <grpc>grpc</grpc>
                    </OptionValues>
                </network>
                <security type="OptionField">
                    <default>none</default>
                    <OptionValues>
                        <none>none</none>
                        <tls>tls</tls>
                        <reality>reality</reality>
                    </OptionValues>
                </security>
                <sni type="TextField"/>
                <path type="TextField"/>
                <user_id type="TextField">
                    <help>vless / vmess 的用户 ID（UUID）。</help>
                </user_id>
                <password type="TextField">
                    <help>trojan / shadowsocks 的密码。</help>
                </password>
                <ss_method type="TextField">
                    <default>aes-256-gcm</default>
                    <help>shadowsocks 加密方式：aes-256-gcm、aes-128-gcm、chacha20-ietf-poly1305、xchacha20-ietf-poly1305、2022-blake3-aes-256-gcm 等。</help>
                </ss_method>
                <vmess_cipher type="OptionField">
                    <default>auto</default>
                    <OptionValues>
                        <auto>auto</auto>
                        <aes-128-gcm>aes-128-gcm</aes-128-gcm>
                        <chacha20-poly1305>chacha20-poly1305</chacha20-poly1305>
                        <none>none</none>
                    </OptionValues>
                </vmess_cipher>
                <flow type="TextField">
                    <help>vless 流控，常用 xtls-rprx-vision，没有就留空。</help>
                </flow>
                <alter_id type="TextField">
                    <Mask>/^[0-9]*$/</Mask>
                    <help>vmess alterId，新版一般为 0。</help>
                </alter_id>
                <host type="TextField">
                    <help>ws / xhttp 的 Host 头（伪装域名）。</help>
                </host>
                <fingerprint type="TextField">
                    <help>TLS / REALITY 指纹：chrome、firefox、safari、ios、android、edge、random。留空默认 chrome（仅 REALITY）。</help>
                </fingerprint>
                <allow_insecure type="BooleanField">
                    <default>0</default>
                    <help>TLS 时跳过证书验证（自签证书才需要）。</help>
                </allow_insecure>
                <public_key type="TextField">
                    <help>REALITY 公钥（pbk）。</help>
                </public_key>
                <short_id type="TextField">
                    <help>REALITY shortId（sid），可留空。</help>
                </short_id>
                <spider_x type="TextField">
                    <help>REALITY spiderX 路径，可留空。</help>
                </spider_x>
                <params type="TextField">
                    <help>高级：完整的 outbound JSON（导入时自动填充）。结构化字段填了凭据时以结构化字段为准，此项仅作旧节点兜底，手动建节点不用填。</help>
                </params>
                <sub_id type="TextField"/>
            </node>
        </nodes>
        <inbounds>
            <inbound type="ArrayField">
                <enabled type="BooleanField">
                    <default>1</default>
                </enabled>
                <tag type="TextField">
                    <Required>Y</Required>
                </tag>
                <protocol type="OptionField">
                    <Required>Y</Required>
                    <OptionValues>
                        <socks>socks</socks>
                        <http>http</http>
                    </OptionValues>
                </protocol>
                <listen type="NetworkField">
                    <default>127.0.0.1</default>
                    <Required>Y</Required>
                </listen>
                <port type="PortField">
                    <Required>Y</Required>
                </port>
                <sniffing type="BooleanField">
                    <default>0</default>
                </sniffing>
                <username type="TextField"/>
                <password type="TextField"/>
            </inbound>
        </inbounds>
        <rules>
            <rule type="ArrayField">
                <enabled type="BooleanField">
                    <default>1</default>
                </enabled>
                <type type="OptionField">
                    <Required>Y</Required>
                    <OptionValues>
                        <domain>domain</domain>
                        <ip>ip</ip>
                        <source>source</source>
                        <port>port</port>
                        <inbound>inbound</inbound>
                        <protocol>protocol</protocol>
                    </OptionValues>
                </type>
                <values type="TextField">
                    <help>Comma separated match values. Empty is allowed for inbound-type rules (they match on inbound_tag instead); the generator skips rules whose condition is empty.</help>
                </values>
                <inbound_tag type="TextField">
                    <help>Inbound tag, only for inbound-type rules (one inbound maps to one outbound). Other rule types ignore it.</help>
                </inbound_tag>
                <order type="IntegerField">
                    <default>100</default>
                    <help>匹配顺序：自小到大，值相同按添加顺序。系统规则（DNS、53 端口、私网）永远排在用户规则之前。</help>
                </order>
                <outbound_tag type="TextField">
                    <help>Node tag, 'direct', 'block', or empty for default node.</help>
                </outbound_tag>
            </rule>
        </rules>
        <subscriptions>
            <subscription type="ArrayField">
                <name type="TextField">
                    <Required>Y</Required>
                </name>
                <url type="TextField">
                    <Required>Y</Required>
                </url>
            </subscription>
        </subscriptions>
    </items>
</model>
