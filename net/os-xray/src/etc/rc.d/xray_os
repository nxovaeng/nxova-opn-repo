#!/bin/sh
#
# PROVIDE: xray_os
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# os-xray: Xray-core proxy engine with custom config.
# Binary is the plugin-bundled /usr/local/bin/xray-os (XTLS release,
# renamed to avoid clashing with the official xray-core package).
# Uses /usr/local/etc/xray-os/config.json (NOT the official xray-core confdir).
# Enable flag is managed by the plugin template in /etc/rc.conf.d/xray_os.

. /etc/rc.subr

name=xray_os
rcvar=xray_os_enable

pidfile=/var/run/xray_os.pid
procname=/usr/local/bin/xray-os
command=/usr/sbin/daemon
# -o captures xray's stdout/stderr (the generated config sets only
# loglevel, no access/error paths, so logs go to stdio). Without it
# nothing ever writes /var/log/xray-os.log and the log page stays
# empty. Truncate (not rm) to clear: daemon holds the file open.
command_args="-p ${pidfile} -o /var/log/xray-os.log ${procname} run -c /usr/local/etc/xray-os/config.json"

load_rc_config $name

# geosite:/geoip: routing rules use the geo data files bundled with this
# plugin (XTLS release, installed to /usr/local/share/xray-os).
export XRAY_LOCATION_ASSET=${XRAY_LOCATION_ASSET:-/usr/local/share/xray-os}

run_rc_command "$1"
